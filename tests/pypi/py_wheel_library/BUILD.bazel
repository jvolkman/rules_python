)

py_sdist_wheel(
    name = "sdist_demo-0.5.0.whldir",
    build_deps = [
        ":classic_bdep",
        ":custom_build_helper",
        ":custom_shadow_dep",
        ":demo_wheel_lib_venv",
    ],
    config_settings_list = {
