    distribution = "sdist-demo",
    pre_build_patch_strips = [1],
    pre_build_patches = ["pre_build.patch"],
    sdist = ":gen_demo_sdist",
    version = "0.5.0",
)

# Verify two bare-named py_sdist_wheel targets building the same sdist in one
# package do not collide on declared output filenames.
