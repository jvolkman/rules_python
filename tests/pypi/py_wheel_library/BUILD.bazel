    name = "sdist_demo_bare_a",
    build_deps = [
        ":classic_bdep",
        ":custom_build_helper",
        ":custom_shadow_dep",
        ":demo_wheel_lib",
    ],
    distribution = "sdist-demo",
    pre_build_patch_strips = [1],
    pre_build_patches = ["pre_build.patch"],
    sdist = ":gen_demo_sdist",
    version = "0.5.0",
)

py_sdist_wheel(
    name = "sdist_demo_bare_b",
    build_deps = [
        ":classic_bdep",
        ":custom_build_helper",
        ":custom_shadow_dep",
        ":demo_wheel_lib",
    ],
    distribution = "sdist-demo",
    pre_build_patch_strips = [1],
    pre_build_patches = ["pre_build.patch"],
    sdist = ":gen_demo_sdist",
    version = "0.5.0",
)

filegroup(
